{
  "name": "tinjs-studio",
  "productName": "VIBE CODE",
  "version": "0.1.2",
  "description": "A desktop workspace for Claude Code: multi-chat, editor, diffs, terminal.",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "chokidar": "3.6.0"
  },
  "devDependencies": {
    "@fontsource/inter": "5.1.0",
    "@fontsource/jetbrains-mono": "5.1.1",
    "@monaco-editor/react": "4.6.0",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "electron": "33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "2.3.0",
    "lucide-react": "0.460.0",
    "monaco-editor": "0.52.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "2.1.7",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "zustand": "5.0.1"
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.vibecode.app",
    "productName": "VIBE CODE",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**",
      "resources/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "artifactName": "VIBE-CODE-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VIBE CODE",
      "runAfterFinish": true
    }
  }
}
