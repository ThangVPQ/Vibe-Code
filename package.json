{
  "name": "tinjs-studio",
  "productName": "VIBE CODE",
  "version": "0.1.2",
  "description": "A desktop workspace for Claude Code: multi-chat, editor, diffs, terminal.",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "chokidar": "6.0.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "lucide-react": "1.75.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.24.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "zustand": "5.1.0"
  },
  "allowScripts": {
    "electron@45.3.4": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.vibecode.app",
    "productName": "VIBE CODE",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**",
      "resources/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "artifactName": "VIBE-CODE-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VIBE CODE",
      "runAfterFinish": true
    }
  }
}
